[
  { "id": "c001", "message": "오늘도 애썼어, 딱 이만큼만 하면 돼.", "category": "cheer" },
  { "id": "c002", "message": "천천히 가도 돼. 방향이 맞으면 충분해.", "category": "cheer" },
  { "id": "c003", "message": "너 오늘 좀 멋있었어. 진짜야.", "category": "cheer" },
  { "id": "c004", "message": "시작한 것만으로 이미 반은 온 거야.", "category": "cheer" },
  { "id": "c005", "message": "오늘의 너는 어제의 너보다 한 뼘 컸어.", "category": "cheer" },
  { "id": "c006", "message": "잘하고 있어. 의심하지 마.", "category": "cheer" },
  { "id": "c007", "message": "네 속도가 제일 좋은 속도야.", "category": "cheer" },
  { "id": "c008", "message": "안 되면 어때, 되게 하면 되지.", "category": "cheer" },
  { "id": "c009", "message": "오늘은 네가 주인공이야.", "category": "cheer" },
  { "id": "c010", "message": "한 걸음이면 충분해. 그게 오늘 몫이야.", "category": "cheer" },
  { "id": "c011", "message": "쉬어가도 괜찮아. 넌 충분히 잘하고 있어.", "category": "comfort" },
  { "id": "c012", "message": "힘든 날엔 힘들다고 말해도 돼.", "category": "comfort" },
  { "id": "c013", "message": "오늘 하루, 버틴 것만으로 대단해.", "category": "comfort" },
  { "id": "c014", "message": "네 잘못이 아니야. 그냥 그런 날이 있는 거야.", "category": "comfort" },
  { "id": "c015", "message": "울고 싶으면 울어. 그다음엔 간식 먹자.", "category": "comfort" },
  { "id": "c016", "message": "완벽하지 않아도 충분히 사랑받을 수 있어.", "category": "comfort" },
  { "id": "c017", "message": "지친 건 그만큼 열심히 살았다는 증거야.", "category": "comfort" },
  { "id": "c018", "message": "괜찮아, 내일의 너는 또 다를 거야.", "category": "comfort" },
  { "id": "c019", "message": "마음이 무거운 날엔 기지개 한 번, 몸부터 가볍게.", "category": "comfort" },
  { "id": "c020", "message": "누가 뭐래도 나는 네 편이야.", "category": "comfort" },
  { "id": "c021", "message": "실수해도 돼. 호랑이도 가끔 미끄러져.", "category": "encourage" },
  { "id": "c022", "message": "지금 막막한 건 네가 성장하는 중이라서 그래.", "category": "encourage" },
  { "id": "c023", "message": "포기 말고 잠깐 멈춤. 그거면 돼.", "category": "encourage" },
  { "id": "c024", "message": "어제 못 한 건 오늘 하면 돼.", "category": "encourage" },
  { "id": "c025", "message": "겁이 나는 건 네가 진심이라는 뜻이야.", "category": "encourage" },
  { "id": "c026", "message": "넘어진 김에 하늘 한 번 보고 가자.", "category": "encourage" },
  { "id": "c027", "message": "네가 견딘 시간들이 너를 지켜줄 거야.", "category": "encourage" },
  { "id": "c028", "message": "느려도 멈추지 않으면 도착해.", "category": "encourage" },
  { "id": "c029", "message": "오늘의 작은 용기가 내일의 큰 힘이 돼.", "category": "encourage" },
  { "id": "c030", "message": "처음이라 무서운 게 당연해. 그래도 넌 할 거잖아.", "category": "encourage" },
  { "id": "c031", "message": "월요일이 무서운 게 아니라, 월요일이 날 무서워해야지.", "category": "humor", "weekday": 1 },
  { "id": "c032", "message": "출근했으면 오늘 할 일 절반은 끝난 거야.", "category": "humor", "timeslot": "morning" },
  { "id": "c033", "message": "간식은 죄가 없어. 먹자.", "category": "humor" },
  { "id": "c034", "message": "고민은 배송비도 안 드는데 왜 쌓아둬? 반품하자.", "category": "humor" },
  { "id": "c035", "message": "오늘의 운세: 귀여운 호랑이를 봤으니 만사형통.", "category": "humor" },
  { "id": "c036", "message": "열심히 안 살아도 돼. 열심히 귀여우면 돼.", "category": "humor" },
  { "id": "c037", "message": "퇴근이 답이다. 그런데 문제가 뭐였더라?", "category": "humor", "timeslot": "evening" },
  { "id": "c038", "message": "물 한 잔 마시자. 오늘의 자기관리 끝.", "category": "humor" },
  { "id": "c039", "message": "침대가 부르는 소리 들려? 환청 아니야.", "category": "humor", "timeslot": "overtime" },
  { "id": "c040", "message": "걱정 총량제 실시 중. 오늘 치는 다 썼어.", "category": "humor" },
  { "id": "c041", "message": "어깨 펴고, 숨 한 번 크게. 지금 바로.", "category": "remind" },
  { "id": "c042", "message": "물 마신 지 오래됐지? 한 잔 하고 오자.", "category": "remind" },
  { "id": "c043", "message": "눈 감고 10초. 모니터도 너도 쉬는 시간.", "category": "remind" },
  { "id": "c044", "message": "점심 대충 먹지 마. 너는 소중하니까.", "category": "remind", "timeslot": "noon" },
  { "id": "c045", "message": "오늘 잘한 일 하나만 떠올려 봐. 분명 있어.", "category": "remind", "timeslot": "evening" },
  { "id": "c046", "message": "스트레칭 한 번이 커피 한 잔보다 나을 때가 있어.", "category": "remind" },
  { "id": "c047", "message": "휴대폰 말고 하늘 한 번 보기. 오늘의 미션.", "category": "remind" },
  { "id": "c048", "message": "야근 중이라면 무리하지 말자. 내일의 너에게 빌리는 힘이야.", "category": "remind", "timeslot": "overtime" },
  { "id": "c049", "message": "허리 펴! 뚱랑이랑 한 약속이야.", "category": "remind" },
  { "id": "c050", "message": "일찍 자는 게 최고의 재테크야.", "category": "remind", "timeslot": "overtime" },
  { "id": "c051", "message": "좋은 아침! 오늘 치 행운 배달 왔어.", "category": "cheer", "timeslot": "morning" },
  { "id": "c052", "message": "아침 거르지 마. 호랑이 기운은 밥심에서 나와.", "category": "remind", "timeslot": "morning" },
  { "id": "c053", "message": "점심 뭐 먹지? 그게 오늘 제일 중요한 회의야.", "category": "humor", "timeslot": "noon" },
  { "id": "c054", "message": "오늘 하루도 무사히. 그거면 충분해.", "category": "comfort", "timeslot": "evening" },
  { "id": "c055", "message": "퇴근길엔 좋아하는 노래 크게 듣기.", "category": "cheer", "timeslot": "evening" },
  { "id": "c056", "message": "이 시간까지 애쓰는 너, 진짜 대단한 거 알지?", "category": "comfort", "timeslot": "overtime" },
  { "id": "c057", "message": "금요일이다! 오늘은 웃는 근육만 쓰자.", "category": "humor", "weekday": 5 },
  { "id": "c058", "message": "월요일의 너에게 호랑이 기운 가득.", "category": "cheer", "weekday": 1 },
  { "id": "c059", "message": "오늘은 아무것도 안 하기에 성공하는 날.", "category": "humor", "weekday": 6 },
